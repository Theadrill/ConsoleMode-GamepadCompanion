<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Fase 1: Exe de console para validar a leitura do XInput. Na Fase 2 muda para WinExe. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ConsoleMode-GamepadCompanion</AssemblyName>
    <RootNamespace>ConsoleMode.GamepadCompanion</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Permite compilar net48 apenas com o SDK (sem Developer Pack instalado) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
